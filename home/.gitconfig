[core]
	# brew install git-delta
	pager = delta

[user]
	name = Js Lim
	email = jslim89@gmail.com

[color]
	ui = auto
	branch = auto
	diff = auto
	status = auto

[diff]
    colorMoved = default

[alias]
	ll = log --oneline --decorate --graph --all

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true    # use n and N to move between diff sections
    #light = true      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
	side-by-side = true
	line-numbers = true

[merge]
	conflictstyle = diff3

