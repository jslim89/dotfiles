# ==============================================================================
# Ghostty Full Configuration (Ported from .tmux.conf)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base Behaviors & Directory Inheritance
# ------------------------------------------------------------------------------
# Mimics: bind-key | split-window -h -c '#{pane_current_path}'
window-inherit-working-directory = true


# ------------------------------------------------------------------------------
# 2. TMUX PASSTHROUGH OVERRIDES (CRITICAL PLACEMENT)
# ------------------------------------------------------------------------------
# We declare these FIRST so Ghostty knows to pass standalone backticks and alt keys
# straight through to Tmux, leaving them unblocked for your yank/copy-mode.
keybind = backquote=unbind
keybind = alt+j=unbind
keybind = alt+k=unbind


# ------------------------------------------------------------------------------
# 3. Window/Tab Management (Ghostty Layers via Alt+Backquote Modifier)
# ------------------------------------------------------------------------------
# Use Alt + Backtick (`) followed by a key to manage native Ghostty interfaces.

# Alt+` + c = New tab (Mimics: bind c new-window)
keybind = alt+backquote>c=new_tab

# Alt+` + - = Horizontal split (Mimics: bind-key - split-window -v)
keybind = alt+backquote>-=new_split:down

# Alt+` + | = Vertical split (Mimics: bind-key | split-window -h)
keybind = alt+backquote>|=new_split:right

# Alt+` + \ = Vertical split fallback (Mimics: bind-key \\ split-window -h)
keybind = alt+backquote>\=new_split:right

# Alt+` + r = Reload configuration (Mimics: bind-key r source-file)
keybind = alt+backquote>r=reload_config


# ------------------------------------------------------------------------------
# 4. Split Pane Navigation (No Leader Key)
# ------------------------------------------------------------------------------
# Smart Pass-Through: If a Ghostty split exists, it moves. If not, it moves inside Neovim.
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right


# ------------------------------------------------------------------------------
# 5. Pane Resizing Shortcuts (No Leader Key)
# ------------------------------------------------------------------------------
# Shift + Arrow Keys (Fine tuning: 1-2 steps)
keybind = shift+arrow_left=resize_split:left,10
keybind = shift+arrow_right=resize_split:right,10
keybind = shift+arrow_down=resize_split:down,10
keybind = shift+arrow_up=resize_split:up,10

# Ctrl + Arrow Keys (Coarse tuning: larger steps)
keybind = ctrl+arrow_left=resize_split:left,40
keybind = ctrl+arrow_right=resize_split:right,40
keybind = ctrl+arrow_down=resize_split:down,40
keybind = ctrl+arrow_up=resize_split:up,40


# ------------------------------------------------------------------------------
# 6. Environmental Variations & Theme
# ------------------------------------------------------------------------------
font-size = 15
font-family = "JetBrains Mono"

macos-option-as-alt = true
theme = seoul256.conf
background-opacity = 1.0
